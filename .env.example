DATABASE_URL=postgresql://docmap:docmap@postgres:5432/docmap
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_THINK_LEVEL=low
OLLAMA_NUM_PREDICT=
EXTRACTOR_MODEL=gpt-oss:20b
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_MIN_INTERVAL_SECONDS=1.1
GEOCODER_USER_AGENT=docmap-geocoder/0.1 (+https://github.com/docmap)
CANONICAL_REFRESH_ON_GEOCODE=0
CANONICAL_DICTIONARY_INPUT=/app/services/geocoder/assets/canonical_dictionary.json
CANONICAL_DICTIONARY_SOURCE=wof
CANONICAL_REFRESH_REPORT_PATH=/app/docs/qa/canonical_dictionary_refresh_report.json
CANONICAL_REFRESH_REPLACE_SOURCE=1
CANONICAL_AUTOSEED_ON_EMPTY=1
CANONICAL_BUILD_SEED_SOURCE_ON_REFRESH=1
CANONICAL_SEED_SOURCE=/app/services/geocoder/assets/canonical_seed_source.geojson
GCP_PROJECT_ID=
BIGQUERY_DATASET=docmap_mvp
BIGQUERY_LOCATION=US
